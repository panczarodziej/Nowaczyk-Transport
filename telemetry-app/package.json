{
  "name": "nowaczyk-transport-telemetry",
  "version": "0.3.41",
  "private": true,
  "description": "Nowaczyk Transport \u2014 panel kierowcy i telemetria",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "prebuild:win": "node prepare-plugin.js",
    "prestart": "node prepare-plugin.js"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pl.nowaczyk.transport.telemetry",
    "productName": "Nowaczyk Transport Telemetry",
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "icon.png",
      "save-importer.js",
      "telemetry-sync.js",
      "plugin-install.js",
      "event-queue.js",
      "game-location.js"
    ],
    "win": {
      "icon": "icon.ico",
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      },
      {
        "from": "rencloud-reader.ps1",
        "to": "rencloud-reader.ps1"
      },
      {
        "from": "memory-reader.ps1",
        "to": "memory-reader.ps1"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/panczarodziej/Nowaczyk-Transport/releases/latest/download"
    },
    "artifactName": "Nowaczyk-Transport-Setup-${version}.${ext}"
  }
}
